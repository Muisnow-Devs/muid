{
  "permissions": {
    "organization": [
      "setting.read",
      "setting.write",
      "member.read",
      "member.write",
      "role.read",
      "role.write",
      "oidc_client.read",
      "oidc_client.write"
    ]
  },
  "system_roles": ["owner", "admin", "manager", "member"],
  "role_inheritance": [
    ["owner", "admin"],
    ["admin", "manager"],
    ["manager", "member"]
  ],
  "grants": {
    "member": [
      "organization/setting.read",
      "organization/member.read",
      "organization/role.read",
      "organization/oidc_client.read"
    ],
    "manager": [
      "organization/member.write"
    ],
    "admin": [
      "organization/role.write",
      "organization/oidc_client.write"
    ],
    "owner": [
      "organization/setting.write"
    ]
  }
}
